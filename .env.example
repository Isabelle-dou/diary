# ============================================
# DiaryEnglish - Environment Variables Example
# ============================================

# ------------------------------------------------
# Database Configuration
# ------------------------------------------------
# SQLite database file (development)
# For production, use PostgreSQL
DATABASE_URL="file:./prisma/dev.db"

# ------------------------------------------------
# NextAuth Configuration
# ------------------------------------------------
# The base URL of your application
NEXTAUTH_URL="http://localhost:3000"

# A secret used to encrypt the NextAuth JWT tokens
# Generate a secure random string using: openssl rand -hex 32
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-hex-32"

# ------------------------------------------------
# DeepSeek API Configuration
# ------------------------------------------------
# Your DeepSeek API key
# Get from: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# The DeepSeek model to use for analysis
# Recommended: deepseek-chat (cost-effective and fast)
DEEPSEEK_MODEL="deepseek-chat"

# ------------------------------------------------
# Vercel Blob Configuration (用于头像存储)
# ------------------------------------------------
# 在 Vercel 控制台创建 Blob 存储后，系统会自动配置以下变量：
# - BLOB_STORE_ID: 存储ID（自动配置）
# - BLOB_WEBHOOK_PUBLIC_KEY: Webhook公钥（自动配置）
# 
# 开发环境：无需手动配置，系统会自动使用本地文件存储
# 生产环境：Vercel会自动配置上述变量，无需手动设置
# 
# 旧版认证方式（已废弃）：
# BLOB_READ_WRITE_TOKEN="your-blob-read-write-token-here"

# ------------------------------------------------
# Development Only (Optional)
# ------------------------------------------------
# Enable debug mode for DeepSeek API
# DEEPSEEK_DEBUG="true"
