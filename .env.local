# ============================================
# DiaryEnglish - Local Environment Variables
# ============================================

# ------------------------------------------------
# Database Configuration
# ------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ------------------------------------------------
# NextAuth Configuration
# ------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="local-development-secret-change-in-production"

# ------------------------------------------------
# DeepSeek API Configuration
# ------------------------------------------------
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_MODEL="deepseek-chat"

# ------------------------------------------------
# Vercel Blob Configuration (头像存储)
# ------------------------------------------------
# 在 Vercel 控制台创建 Blob 存储后获取
# https://vercel.com/docs/storage/vercel-blob
# BLOB_READ_WRITE_TOKEN="your-blob-read-write-token-here"